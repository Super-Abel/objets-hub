# API
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/objets-hub

# S3 / MinIO (S3-compatible, non-AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=objects
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public base URL used to build imageUrl (MinIO serves <endpoint>/<bucket>/<key>)
S3_PUBLIC_URL=http://localhost:9000
# MinIO needs path-style addressing
S3_FORCE_PATH_STYLE=true
# Max accepted image size in bytes (default 5 MiB)
S3_MAX_IMAGE_BYTES=5242880
# Key prefix for stored images
S3_KEY_PREFIX=

# Async queue (BullMQ + Redis). false => image deletion runs inline in the request.
OBJECTS_QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379
OBJECTS_QUEUE_CONCURRENCY=3
